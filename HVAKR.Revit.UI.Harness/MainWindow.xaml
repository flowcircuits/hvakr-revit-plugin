<Window x:Class="HVAKR.Revit.UI.Harness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HVAKR.Revit.UI.Harness"
        mc:Ignorable="d"
        Title="HVAKR Pane — Dev Harness" Height="680" Width="320">
    <DockPanel>
        <CheckBox x:Name="DarkThemeToggle" DockPanel.Dock="Top" Content="Dark theme" Margin="8"
                  Checked="DarkThemeToggle_Changed" Unchecked="DarkThemeToggle_Changed"/>
        <Grid x:Name="RootGrid" />
    </DockPanel>
</Window>
