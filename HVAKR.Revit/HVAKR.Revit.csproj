<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The .addin manifest points at HVAKR.Revit.dll — keep AssemblyName stable. -->
    <AssemblyName>HVAKR.Revit</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Deploy\Bundle holds only HVAKR.bundle, so the zip has HVAKR.bundle at its root. -->
    <BundleStageDir>$(MSBuildProjectDirectory)\Deploy\Bundle</BundleStageDir>
    <BundleDir>$(BundleStageDir)\HVAKR.bundle</BundleDir>
    <BundleZip>$(MSBuildProjectDirectory)\Deploy\HVAKR-Revit-Plugin-$(VersionPrefix).zip</BundleZip>
    <ApplicationPluginsDir>$(APPDATA)\Autodesk\ApplicationPlugins</ApplicationPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HVAKR.Revit.UI\HVAKR.Revit.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <!-- Revit 2026 SDK. The UI library targets 2025 on purpose (see AGENTS.md -> version skew). Compile-only; Revit supplies these at runtime. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(Revit2026ApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(Revit2026ApiVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Stages HVAKR.bundle with one Contents\<year> folder per supported Revit release. Release signs the DLLs here before BuildBundle zips them. -->
  <Target Name="PrepareBundle" DependsOnTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(SkipPrepareBundle)' != 'true'">
    <PropertyGroup>
      <!-- Autodesk wants a new ProductCode per AppVersion. Derive it from the version so rebuilds agree. -->
      <BundleProductCode>{EEAD87A6-6EC3-4B86-88B6-$([System.Version]::Parse('$(VersionPrefix)').Major.ToString().PadLeft(4, '0'))$([System.Version]::Parse('$(VersionPrefix)').Minor.ToString().PadLeft(4, '0'))$([System.Version]::Parse('$(VersionPrefix)').Build.ToString().PadLeft(4, '0'))}</BundleProductCode>
    </PropertyGroup>
    <ItemGroup>
      <PluginFiles Include="$(TargetDir)**\*" Exclude="$(TargetDir)RevitAPI.dll;$(TargetDir)RevitAPIUI.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(BundleStageDir)" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(BundleDir)\Contents\2025\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(BundleDir)\Contents\2026\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="Bundle\HVAKR.addin" DestinationFolder="$(BundleDir)\Contents\2025" />
    <Copy SourceFiles="Bundle\HVAKR.addin" DestinationFolder="$(BundleDir)\Contents\2026" />
    <Copy SourceFiles="Bundle\hvakr.ico" DestinationFolder="$(BundleDir)\Contents\Resources" />
    <WriteLinesToFile File="$(BundleDir)\PackageContents.xml" Lines="$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Bundle\PackageContents.xml').Replace('@VERSION@', '$(VersionPrefix)').Replace('@PRODUCT_CODE@', '$(BundleProductCode)'))" Overwrite="true" />
  </Target>

  <Target Name="BuildBundle" DependsOnTargets="PrepareBundle" Condition="'$(Configuration)' == 'Release'">
    <ZipDirectory SourceDirectory="$(BundleStageDir)" DestinationFile="$(BundleZip)" Overwrite="true" />
  </Target>

  <Target Name="InstallLocal" DependsOnTargets="PrepareBundle" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="Exists('$(APPDATA)\Autodesk\Revit\Addins\2025\HVAKR.addin') Or Exists('$(APPDATA)\Autodesk\Revit\Addins\2026\HVAKR.addin') Or Exists('$(ProgramData)\Autodesk\Revit\Addins\2025\HVAKR.addin') Or Exists('$(ProgramData)\Autodesk\Revit\Addins\2026\HVAKR.addin')" Text="Remove the old installer-based HVAKR add-in first (see README) or Revit will load HVAKR twice." />
    <Exec Command="powershell -NoProfile -Command &quot;if (Get-Process Revit -ErrorAction SilentlyContinue) { Write-Error 'Close every Revit process before installing HVAKR locally.'; exit 1 }&quot;" />
    <RemoveDir Directories="$(ApplicationPluginsDir)\HVAKR.bundle" />
    <ItemGroup>
      <BundleFiles Include="$(BundleDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundleFiles)" DestinationFiles="@(BundleFiles->'$(ApplicationPluginsDir)\HVAKR.bundle\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
